FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install gunicorn

# Copy application files
COPY wsgi.py ./wsgi.py
COPY app.py ./app.py
COPY run_migrations.py ./run_migrations.py
COPY docker-entrypoint.sh ./docker-entrypoint.sh
COPY application/controllers ./application/controllers
COPY application/models.py ./application/models.py
COPY application/__init__.py ./application/__init__.py
COPY application/services ./application/services
COPY application/schemas ./application/schemas
COPY ./application/celery_app.py ./application/celery_app.py

# Make entrypoint executable
RUN chmod +x docker-entrypoint.sh

# Create user and set permissions BEFORE switching user
RUN useradd -ms /bin/bash appuser

# Create migrations directory with proper permissions
RUN mkdir -p migrations && chown -R appuser:appuser /app

USER appuser

ENV FLASK_APP=wsgi.py
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["gunicorn", "--workers", "3", "--bind", "0.0.0.0:8000", "wsgi:app"]
